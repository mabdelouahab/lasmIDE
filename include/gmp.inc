	__mpz_struct STRUCT
		_mp_alloc	dq	0;			/* Number of *limbs* allocated and pointed  to by the _mp_d field.  */
		_mp_size	dq	0;			/* abs(_mp_size) is the number of limbs the last field points to.  If _mp_size is negative this is a negative number.  */
		_mp_d		dq	0;			/* Pointer to the limbs.  */
	__mpz_struct ENDS

	__mpf_struct STRUCT
		_mp_prec	dq	0;			/* Max precision, in number of `mp_limb_t's. Set by mpf_init and modified by mpf_set_prec.  The area pointed to by the   _mp_d field contains `prec' + 1 limbs.  */
		_mp_size	dq	0;			/* abs(_mp_size) is the number of limbs the last field points to.  If _mp_size is negative this is a negative number.  */
		_mp_exp		dq	0;			;		/* Exponent, in the base of `mp_limb_t'.  */
		_mp_d		dq	0;			;		/* Pointer to the limbs.  */
	__mpf_struct ENDS


