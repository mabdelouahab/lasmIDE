[Project]
Name=lasmWin64
Description=lasmWin64
MainFile=main.asm
Assemble=uasm   -c -win64 -Zp8 -Zi -nologo  $SRC   
Link=gcc -s   -o $EXE.exe $OBJ -llibgdk-3-0 -llibgdk_pixbuf-2.0-0 -llibglib-2.0-0 -llibpango-1.0-0 -llibgtk-3-0 -llibgobject-2.0-0 -llibgtksourceview-3.0-1 -llibgmodule-2.0-0 -llibgthread-2.0-0 -llibcairo-2 -lmsvcrt -LC:/msys64/mingw64/bin
Run_cmd=./$EXE 
Files=main.asm;main.inc;inputbox.asm;Helpers.inc;Settings.inc;icons.inc;STNG.inc;spawn.inc;build.inc;Wedg_Dialog_Project_Option.wedg;files.inc;Notebook.inc;TreeView.inc;Projects.inc;TemplateProjectDialog.wedg;mainwindow.wedg;MainWindow.inc;signal_connect.asm;findandreplace.wedg;include.inc;FilesTypes.wedg;folding.inc;Cfolding.inc;wterminal.inc;
Dirs=

